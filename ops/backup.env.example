PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=teacher_platform
PGUSER=teacher_platform_backup
PGPASSFILE=/etc/teacher-platform/pgpass
BACKUP_ROOT=/var/backups/teacher-platform
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient
# Optional off-host copy, for example: s3:teacher-platform-backups/production
BACKUP_RCLONE_REMOTE=
