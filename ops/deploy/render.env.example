# Copy these keys to Render. This file is intentionally unusable until every
# SET_* or placeholder value is replaced in Render's environment settings.
# Render supplies PORT. The Docker image binds to 0.0.0.0:$PORT and defaults to 10000 locally.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection="Host=aws-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=SET_IN_RENDER_SECRET_STORE;SSL Mode=Require"

Jwt__Issuer=https://API_NAME.onrender.com
Jwt__Audience=https://APP_NAME.vercel.app
Jwt__SigningKey=SET_IN_RENDER_SECRET_STORE_MINIMUM_32_CHARACTERS
Jwt__AccessTokenMinutes=15
Jwt__ClockSkewMinutes=1

Auth__RefreshTokenDays=30
Auth__UseSecureCookie=true
Auth__CookieSameSite=None
Auth__TrustedOrigins__0=https://APP_NAME.vercel.app
Auth__WebBaseUrl=https://APP_NAME.vercel.app

IdentityLockout__MaxFailedAccessAttempts=5
IdentityLockout__DefaultLockoutMinutes=15
Cors__AllowedOrigins__0=https://APP_NAME.vercel.app

DataProtection__ApplicationName=TeacherPlatform
DataProtection__KeysDirectory=/var/data/teacher-platform/data-protection

RateLimiting__PermitLimit=20
RateLimiting__WindowSeconds=60
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

QuizLimits__MaxQuizzesPerTenant=100
QuizLimits__MaxQuestionsPerQuiz=200
QuizLimits__MaxPublishedQuizzesPerTenant=50

Session__GraceWindowSeconds=10
Session__GuestTokenDays=30
Session__JoinCodeLength=8
Session__MaxParticipantsPerSession=500
Session__LiveDefaultQuestionSeconds=30
Session__LiveTokenMinutes=5
Session__LiveMonitorIntervalSeconds=1

Mail__Provider=Smtp
Mail__Host=SMTP_HOST_FROM_PROVIDER
Mail__Port=SMTP_PORT_FROM_PROVIDER
Mail__Username=SET_IN_RENDER_SECRET_STORE
Mail__Password=SET_IN_RENDER_SECRET_STORE
Mail__Security=StartTls
Mail__FromAddress=VERIFIED_SENDER_ADDRESS
Mail__FromName="Teacher Platform"

Storage__Provider=S3
Storage__Endpoint=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
Storage__Bucket=PRIVATE_BUCKET_NAME
Storage__AccessKey=SET_IN_RENDER_SECRET_STORE
Storage__SecretKey=SET_IN_RENDER_SECRET_STORE
Storage__Region=PROJECT_REGION_FROM_SUPABASE_S3_SETTINGS
Storage__ForcePathStyle=true
Storage__DownloadUrlExpiryMinutes=5
Storage__ImageMaxBytes=5242880
Storage__AudioMaxBytes=20971520

Certificates__QuestPdfLicense=CHOOSE_COMMUNITY_PROFESSIONAL_OR_ENTERPRISE
Certificates__LinuxFontFamily="DejaVu Sans"
Certificates__ParentShareDays=7
Certificates__WorkerPollSeconds=5
Certificates__MaxProcessingAttempts=5
Certificates__ProcessingLockSeconds=60

SeedRoles=true
