ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=teacher_platform;Username=teacher_platform;Password=REPLACE_FROM_SECRET_STORE"
Jwt__Issuer=https://api.example.com
Jwt__Audience=https://app.example.com
Jwt__SigningKey=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
Jwt__AccessTokenMinutes=15
Jwt__ClockSkewMinutes=1
Auth__RefreshTokenDays=30
Auth__UseSecureCookie=true
Auth__CookieSameSite=Lax
Auth__TrustedOrigins__0=https://app.example.com
Auth__WebBaseUrl=https://app.example.com
IdentityLockout__MaxFailedAccessAttempts=5
IdentityLockout__DefaultLockoutMinutes=15
Cors__AllowedOrigins__0=https://app.example.com
DataProtection__ApplicationName=TeacherPlatform
DataProtection__KeysDirectory=/var/lib/teacher-platform/data-protection
RateLimiting__PermitLimit=20
RateLimiting__WindowSeconds=60
Logging__LogLevel__Default=Information
QuizLimits__MaxQuizzesPerTenant=100
QuizLimits__MaxQuestionsPerQuiz=200
QuizLimits__MaxPublishedQuizzesPerTenant=50
Session__GraceWindowSeconds=10
Session__GuestTokenDays=30
Session__JoinCodeLength=8
Session__MaxParticipantsPerSession=500
Session__LiveDefaultQuestionSeconds=30
Session__LiveTokenMinutes=5
Session__LiveMonitorIntervalSeconds=1
Mail__Provider=Smtp
Mail__Host=smtp.example.com
Mail__Port=587
Mail__Username=REPLACE_FROM_SECRET_STORE
Mail__Password=REPLACE_FROM_SECRET_STORE
Mail__Security=StartTls
Mail__FromAddress=no-reply@example.com
Mail__FromName="Teacher Platform"
Storage__Provider=S3
Storage__Endpoint=https://s3.example.com
Storage__Bucket=teacher-platform-production
Storage__AccessKey=REPLACE_FROM_SECRET_STORE
Storage__SecretKey=REPLACE_FROM_SECRET_STORE
Storage__Region=us-east-1
Storage__ForcePathStyle=true
Storage__DownloadUrlExpiryMinutes=5
Storage__ImageMaxBytes=5242880
Storage__AudioMaxBytes=20971520
Certificates__QuestPdfLicense=REPLACE_AFTER_LICENSE_REVIEW
Certificates__LinuxFontFamily="DejaVu Sans"
Certificates__ParentShareDays=7
Certificates__WorkerPollSeconds=5
Certificates__MaxProcessingAttempts=5
Certificates__ProcessingLockSeconds=60
SeedRoles=true
