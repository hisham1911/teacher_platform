{
  "Jwt": {
    "Issuer": "teacher-platform-dev",
    "Audience": "teacher-platform-dev",
    "SigningKey": "dev-signing-key-pad-to-32-characters-0123456789abcdef",
    "AccessTokenMinutes": 15,
    "ClockSkewMinutes": 1
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "UseSecureCookie": false,
    "CookieSameSite": "Lax",
    "TrustedOrigins": [ "http://localhost:5173" ],
    "WebBaseUrl": "http://localhost:5173"
  },
  "IdentityLockout": {
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutMinutes": 15
  },
  "Mail": {
    "DevDropDirectory": ".dev-mail"
  },
  "DataProtection": {
    "ApplicationName": "TeacherPlatform",
    "KeysDirectory": ""
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "WindowSeconds": 60
  },
  "Session": {
    "GraceWindowSeconds": 10,
    "GuestTokenDays": 30,
    "JoinCodeLength": 8,
    "MaxParticipantsPerSession": 500,
    "LiveDefaultQuestionSeconds": 30,
    "LiveTokenMinutes": 5,
    "LiveMonitorIntervalSeconds": 1
  },
  "Certificates": {
    "QuestPdfLicense": "",
    "WindowsFontFamily": "Arial",
    "LinuxFontFamily": "DejaVu Sans",
    "ParentShareDays": 7,
    "WorkerPollSeconds": 5,
    "MaxProcessingAttempts": 5,
    "ProcessingLockSeconds": 60
  },
  "SeedRoles": true,
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": ".media-storage",
    "ImageMaxBytes": 5242880,
    "AudioMaxBytes": 20971520,
    "DownloadUrlExpiryMinutes": 5
  }
}
