{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=teacher_platform_ci;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "teacher-platform-tests",
    "Audience": "teacher-platform-tests",
    "SigningKey": "test-signing-key-pad-to-32-characters-0123456789abcdef",
    "AccessTokenMinutes": 15,
    "ClockSkewMinutes": 1
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "UseSecureCookie": false,
    "CookieSameSite": "Lax",
    "TrustedOrigins": [ "http://localhost:5173", "https://localhost" ],
    "WebBaseUrl": "http://localhost:5173"
  },
  "IdentityLockout": {
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutMinutes": 15
  },
  "Mail": {
    "Provider": "File",
    "DevDropDirectory": ".test-mail"
  },
  "DataProtection": {
    "ApplicationName": "TeacherPlatform.Tests",
    "KeysDirectory": ""
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "WindowSeconds": 60
  },
  "Session": {
    "GraceWindowSeconds": 10,
    "GuestTokenDays": 30,
    "JoinCodeLength": 8,
    "MaxParticipantsPerSession": 500,
    "LiveDefaultQuestionSeconds": 10,
    "LiveTokenMinutes": 5,
    "LiveMonitorIntervalSeconds": 1
  },
  "StudentPortal": {
    "Enabled": true,
    "SessionRetentionDays": 90
  },
  "QuizLimits": {
    "MaxQuizzesPerTenant": 2,
    "MaxQuestionsPerQuiz": 200,
    "MaxPublishedQuizzesPerTenant": 50
  },
  "Certificates": {
    "QuestPdfLicense": "Community",
    "WindowsFontFamily": "Arial",
    "LinuxFontFamily": "DejaVu Sans",
    "ParentShareDays": 7,
    "WorkerPollSeconds": 60,
    "MaxProcessingAttempts": 3,
    "ProcessingLockSeconds": 30
  },
  "SeedRoles": false,
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": ".test-media-storage",
    "ImageMaxBytes": 1048576,
    "AudioMaxBytes": 5242880
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
