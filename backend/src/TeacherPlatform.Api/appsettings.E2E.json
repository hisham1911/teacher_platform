{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=teacher_platform_e2e;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "teacher-platform-e2e",
    "Audience": "teacher-platform-e2e",
    "SigningKey": "e2e-signing-key-pad-to-32-characters-0123456789abcdef",
    "AccessTokenMinutes": 15,
    "ClockSkewMinutes": 1
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "UseSecureCookie": false,
    "CookieSameSite": "Lax",
    "TrustedOrigins": [ "http://localhost:5173" ],
    "WebBaseUrl": "http://localhost:5173"
  },
  "IdentityLockout": {
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutMinutes": 15
  },
  "Mail": {
    "DevDropDirectory": ".dev-mail"
  },
  "DataProtection": {
    "ApplicationName": "TeacherPlatform",
    "KeysDirectory": ""
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 60
  },
  "Session": {
    "GraceWindowSeconds": 10,
    "GuestTokenDays": 30,
    "JoinCodeLength": 8,
    "MaxParticipantsPerSession": 500,
    "LiveDefaultQuestionSeconds": 15,
    "LiveTokenMinutes": 5,
    "LiveMonitorIntervalSeconds": 1
  },
  "QuizLimits": {
    "MaxQuizzesPerTenant": 2,
    "MaxQuestionsPerQuiz": 200,
    "MaxPublishedQuizzesPerTenant": 50
  },
  "Certificates": {
    "QuestPdfLicense": "Community",
    "WindowsFontFamily": "Arial",
    "LinuxFontFamily": "DejaVu Sans",
    "ParentShareDays": 7,
    "WorkerPollSeconds": 1,
    "MaxProcessingAttempts": 3,
    "ProcessingLockSeconds": 30
  },
  "SeedRoles": true,
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
